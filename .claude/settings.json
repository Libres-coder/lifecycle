{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lifecycle snapshot --hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lifecycle resume"
          }
        ],
        "matcher": "startup|resume|compact"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "lifecycle statusline"
  }
}
