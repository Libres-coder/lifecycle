{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lifecycle snapshot --hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lifecycle resume"
          }
        ],
        "matcher": "compact|resume"
      }
    ]
  }
}
